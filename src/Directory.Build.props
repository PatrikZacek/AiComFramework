<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Authors>Patrik Zacek</Authors>
    <PackageProjectUrl>https://github.com/PatrikZacek/AiComFramework</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PatrikZacek/AiComFramework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ai;llm;prompts;composition;dotnet</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
  <!-- Source Link is included in the exactly pinned .NET SDK. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../eng/PackageReadme.md" Pack="true" PackagePath="/README.md" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
