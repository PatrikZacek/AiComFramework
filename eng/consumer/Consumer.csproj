<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AIComFramework.Abstractions" Version="[__PACKAGE_VERSION__]" />
    <PackageReference Include="AIComFramework.Core" Version="[__PACKAGE_VERSION__]" />
    <PackageReference Include="AIComFramework.Serialization.Json" Version="[__PACKAGE_VERSION__]" />
  </ItemGroup>
</Project>
